@model IEnumerable<Consulta>
@{
    ViewData["Title"] = "Minhas Consultas";
}

<div class="page-header">
    <h2>Minhas Consultas</h2>
    <a class="btn btn-primary" asp-action="Create">+ Nova Consulta</a>
</div>

@if (!Model.Any())
{
    <p class="empty-state">Você ainda não possui consultas cadastradas.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Especialidade</th>
                <th>Data e Hora</th>
                <th>Descrição</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var consulta in Model)
            {
                <tr>
                    <td>@consulta.Especialidade</td>
                    <td>@consulta.DataHora.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@consulta.Descricao</td>
                    <td class="actions">
                        <a asp-action="Edit" asp-route-id="@consulta.Id">Editar</a>
                        <a asp-action="Delete" asp-route-id="@consulta.Id" class="danger">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
