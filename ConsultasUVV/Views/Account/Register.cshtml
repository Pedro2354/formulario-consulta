@model RegisterViewModel
@{
    ViewData["Title"] = "Criar Conta";
}

<h2>Criar Conta</h2>

<div class="form-card">
    <form asp-controller="Account" asp-action="Register" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="form-group">
            <label asp-for="Nome"></label>
            <input asp-for="Nome" class="form-control" autocomplete="name" />
            <span asp-validation-for="Nome" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Email"></label>
            <input asp-for="Email" class="form-control" autocomplete="email" />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Senha"></label>
            <input asp-for="Senha" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Senha" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="ConfirmarSenha"></label>
            <input asp-for="ConfirmarSenha" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmarSenha" class="field-error"></span>
        </div>

        <button type="submit" class="btn btn-primary">Cadastrar</button>
    </form>

    <p class="form-footer">
        Já tem conta? <a asp-controller="Account" asp-action="Login">Entrar</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
